# ==========================================================
# UniVerse – mẫu biến môi trường
# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# ==========================================================

NODE_ENV=development
PORT=3000

# Kết nối MySQL 8.x. Mật khẩu có ký tự đặc biệt phải URL-encode (vd: @ -> %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/universe"

# Chuỗi ngẫu nhiên dài >= 32 ký tự. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Thời gian sống của phiên đăng nhập (giờ)
SESSION_TTL_HOURS=168

# Upload
UPLOAD_MAX_MB=25
# Dung lượng mặc định cho mỗi người dùng (MB)
USER_STORAGE_QUOTA_MB=1024

# ---------------- AI (tùy chọn) ----------------
# Để trống AI_PROVIDER => AI "chưa được cấu hình", các chức năng khác vẫn chạy.
# Giá trị hợp lệ: openai | gemini   (chỉ chọn MỘT)
AI_PROVIDER=
# Key của provider đã chọn. Lấy key tại:
#   OpenAI: https://platform.openai.com/api-keys   (dạng sk-...; tài khoản cần có credit/billing)
#   Gemini: https://aistudio.google.com/apikey     (dạng AIza...; có gói miễn phí giới hạn)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Hoặc dùng một biến chung cho provider đang chọn (chỉ dùng khi biến riêng ở trên để trống)
AI_API_KEY=

# Model – bỏ trống = mặc định trong src/config/index.js
#   (OpenAI: gpt-4o-mini / text-embedding-3-small; Gemini: gemini-flash-latest / gemini-embedding-001)
# Chạy "npm run ai:check" để xem model mà key của bạn được phép dùng.
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# Bật/tắt tạo embedding cho RAG (embedding cũng tính phí theo provider)
AI_EMBEDDINGS_ENABLED=true

AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=24000
# Model "suy nghĩ" (reasoning) cần nhiều token đầu ra hơn – tăng nếu gặp lỗi AI_MAX_TOKENS
AI_MAX_OUTPUT_TOKENS=2048
# Số request AI tối đa mỗi người dùng mỗi ngày
AI_DAILY_REQUEST_LIMIT=100

# Mức log: error | warn | info | debug
LOG_LEVEL=info
